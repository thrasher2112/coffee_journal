# Copy to .env and update values for local development
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/coffee_journal
POSTGRES_DB=coffee_journal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DEBUG=true
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Only needed when the API and the frontend are on DIFFERENT origins. The
# production image serves both from one origin, so leave this unset there and
# the app will call relative /api paths.
# VITE_API_URL=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24
RESEND_API_KEY=
# Sender for magic-link emails. Must be a domain verified in Resend; the default
# test sender below needs no verification but only delivers to your own Resend
# account address.
RESEND_FROM=Coffee Journal <onboarding@resend.dev>
MAGIC_LINK_EXPIRY_MINUTES=15
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Number of proxies in front of the app that append to X-Forwarded-For.
# 0 = reached directly, so that header is untrusted (correct for local dev).
# Set to 1 behind a single load balancer such as Render. Never set it higher
# than the real hop count - that lets callers forge their rate-limit identity.
TRUSTED_PROXY_HOPS=0

# Seed data owner. Seeding is OPT-IN and skipped entirely when this is unset.
# Set it to an address YOU control (it becomes a real, magic-link-loggable
# account). Never ship a shared default here - whoever controls that domain's
# mailbox could request a sign-in link and take the account over.
# Leave unset in production.
# SEED_USER_EMAIL=you@example.com

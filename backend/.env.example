# Copy to .env and update values for local development
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/coffee_journal
POSTGRES_DB=coffee_journal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DEBUG=true
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24
RESEND_API_KEY=
MAGIC_LINK_EXPIRY_MINUTES=15
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Seed data owner. Seeding is OPT-IN and skipped entirely when this is unset.
# Set it to an address YOU control (it becomes a real, magic-link-loggable
# account). Never ship a shared default here - whoever controls that domain's
# mailbox could request a sign-in link and take the account over.
# Leave unset in production.
# SEED_USER_EMAIL=you@example.com

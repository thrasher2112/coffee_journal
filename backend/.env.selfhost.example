# Copy to backend/.env.selfhost, fill in, never commit.
#
# For the SELF-HOSTED option (docker-compose.selfhost.yml). If you deploy on
# Render instead, these same values are set in the Render dashboard and are
# described by render.yaml -- you do not need this file.

# Local Postgres on the compose network. (The Render option uses Neon; the
# app rewrites either URL to the psycopg3 driver itself.)
POSTGRES_DB=coffee_journal
POSTGRES_USER=postgres
# Postgres fixes this at first initdb and never re-reads it. Changing it
# later, after the volume already exists, gets you a silent auth mismatch
# between this value and the one below -- either drop the postgres_data
# volume (destroys all data) or run ALTER USER postgres WITH PASSWORD '...'
# inside the db container and update DATABASE_URL to match.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@db:5432/coffee_journal

# DEBUG is intentionally absent. Setting it disarms the boot guards.

# Public origin. Single origin, so both are the same value, no trailing slash.
# FRONTEND_URL builds the magic-link URL; a wrong value fails silently -- the
# mail sends, the link is dead.
FRONTEND_URL=https://coffee.example.com
API_URL=https://coffee.example.com

# 32+ chars or the app refuses to boot:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_32_PLUS_RANDOM_CHARS_LONG
# 720h = 30 days. At the default 24 you get a magic-link email every day on
# your phone. Sessions stay revocable -- logout bumps token_version.
JWT_EXPIRY_HOURS=720
MAGIC_LINK_EXPIRY_MINUTES=15

COOKIE_SECURE=true
# Single hostname, so leave empty for a host-only cookie.
COOKIE_DOMAIN=

# Number of proxies in front of the app that APPEND to X-Forwarded-For.
#
# 0 here is a DELIBERATE BOOTSTRAP VALUE, not a placeholder to fill in before
# first boot. Measuring the real value requires the app to already be
# running (see "Measuring TRUSTED_PROXY_HOPS" in README.md) - shipping a
# CHANGE_ME string here would make the app crash at startup (int() on a
# non-integer) before it could ever be measured, and the app must boot to be
# measured at all.
#
# At 0 the app is reachable directly and X-Forwarded-For is ignored, so it
# falls back to the raw TCP peer. Once a proxy is in front, that peer is the
# proxy's own address - identical for every visitor - which collapses
# everyone into one shared rate-limit bucket rather than disabling limiting
# outright. That is degraded, not safe: do not make this deployment publicly
# reachable until you have measured the real value and set it below.
#
# No non-zero default here would be correct for everyone - it depends
# entirely on your proxy chain. Render measured 3 for its own chain
# (Cloudflare, then Render's internal load balancer - see config.py); a
# single local Caddy or nginx is typically 1, and a Cloudflare Tunnel is
# typically 1 or 2 - but "typically" means measure it for your own setup,
# not assume it.
TRUSTED_PROXY_HOPS=0

# Comma-separated. EMPTY MEANS ANYONE CAN SIGN UP -- sign-in is passwordless,
# so requesting a link for an address you control is registration.
ALLOWED_EMAILS=you@example.com

RESEND_API_KEY=CHANGE_ME
# Must be a domain verified in Resend. The onboarding@resend.dev default needs
# no verification but only delivers to your own Resend account address.
RESEND_FROM=Coffee Journal <noreply@example.com>

# SEED_USER_EMAIL intentionally absent -- no account is auto-created.
